---
import Band from '../components/Band.astro';
import Icon from '../components/Icon.astro';
import NoteList from '../components/NoteList.astro';
import Page from '../components/Page.astro';
import ProjectList from '../components/ProjectList.astro';
import { getNotes, getProjects } from '../entries';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const projects = (await getProjects()).filter(({ data }) => data.featured);
const notes = (await getNotes()).slice(0, 5);
---

<Base>
	<Page railLabel="Elsewhere">
		<Fragment slot="head">
			<h1 class="display">Hi, I'm Brandon.</h1>
			<p class="lede">
				I'm a developer and student in Southern California. I build Discord bots, games, and small
				tools, mostly in Python and JavaScript, and I'm studying data structures in C++ and x86
				assembly.
			</p>
			<p class="about">
				This site collects what I've built and short notes on what I've learned along the way.
			</p>
		</Fragment>
		<div class="rail-group" slot="rail">
			<h2 class="label">Elsewhere</h2>
			<ul class="rail-items">
				{
					SITE.links.map(({ href, label }) => (
						<li>
							<a class="icon-link" href={href}>
								{label}
								<Icon name="arrow-up-right" />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</Page>

	<Band label="Selected projects" href="/projects/" linkLabel="All projects">
		<ProjectList projects={projects} level={3} />
	</Band>

	<Band label="Recently learned" href="/notes/" linkLabel="All notes">
		<NoteList notes={notes} level={3} />
	</Band>
</Base>

<style>
	.about {
		margin: 1rem 0 0;
		color: var(--muted);
	}
</style>
