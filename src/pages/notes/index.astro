---
import { getCollection } from 'astro:content';
import NoteList from '../../components/NoteList.astro';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const tags = [...new Set(notes.flatMap((note) => note.data.tags))].sort();
---

<Base title="Notes" description="Short notes on things Brandon Walter has learned.">
	<header class="page-head">
		<h1>Notes</h1>
		<p class="lede">Short write-ups of things I've learned, newest first.</p>
		{
			tags.length > 0 && (
				<p class="meta inline-list">
					{tags.map((tag) => (
						<a href={`/notes/tags/${tag}/`}>#{tag}</a>
					))}
				</p>
			)
		}
	</header>
	<NoteList notes={notes} />
</Base>
