---
import NoteList from '../../components/NoteList.astro';
import Page from '../../components/Page.astro';
import TagMenu from '../../components/TagMenu.astro';
import { getNotes } from '../../entries';
import Base from '../../layouts/Base.astro';

const notes = await getNotes();
const tags = [...new Set(notes.flatMap((note) => note.data.tags))].sort();
---

<Base title="Notes" description="Short notes on things Brandon Walter has learned.">
	<Page railLabel="Tags">
		<Fragment slot="head">
			<h1 class="display">Notes</h1>
			<p class="lede">Short write-ups of things I've learned, newest first.</p>
		</Fragment>
		{tags.length > 0 && <TagMenu slot="rail" tags={tags} />}
		<NoteList notes={notes} detailed />
	</Page>
</Base>
