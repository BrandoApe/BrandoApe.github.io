---
import { type CollectionEntry, getCollection } from 'astro:content';
import NoteList from '../../../components/NoteList.astro';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
	const notes = (await getCollection('notes')).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
	);
	const tags = new Set(notes.flatMap((note) => note.data.tags));
	return [...tags].map((tag) => ({
		params: { tag },
		props: { tag, notes: notes.filter((note) => note.data.tags.includes(tag)) },
	}));
}

interface Props {
	tag: string;
	notes: CollectionEntry<'notes'>[];
}

const { tag, notes } = Astro.props;
---

<Base title={`#${tag}`} description={`Notes tagged ${tag}.`}>
	<header class="page-head">
		<h1>#{tag}</h1>
		<p class="meta"><a href="/notes/">← All notes</a></p>
	</header>
	<NoteList notes={notes} />
</Base>
