---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
	projects: CollectionEntry<'projects'>[];
	/** The heading level of each title: 2 below a page title, 3 below a section label. */
	level?: 2 | 3;
}

const { projects, level = 2 } = Astro.props;
const Title = `h${level}` as const;
---

<ul class="projects">
	{
		projects.map(({ id, data }) => (
			<li class="project">
				<Title class="title">
					<a href={`/projects/${id}/`}>
						{data.title}
						<Icon name="arrow-right" />
					</a>
				</Title>
				<span class="meta">{data.date.getUTCFullYear()}</span>
				<p>{data.description}</p>
				{data.stack.length > 0 && (
					<ul class="stack meta" aria-label="Built with">
						{data.stack.map((tool) => (
							<li>{tool}</li>
						))}
					</ul>
				)}
			</li>
		))
	}
</ul>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project {
		display: grid;
		position: relative;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		column-gap: 1rem;
		padding-block: 1.25rem;
		border-top: 1px solid var(--line);
	}

	.title {
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.4;
		letter-spacing: -0.01em;
	}

	.title a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}

	/* The link covers its whole row, so a click anywhere on the row opens the project. */
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.title :global(.icon) {
		color: var(--muted);
		transition:
			color 0.15s,
			transform 0.15s;
	}

	.project:hover .title a,
	.project:hover .title :global(.icon) {
		color: var(--accent);
	}

	.project:hover .title :global(.icon) {
		transform: translateX(3px);
	}

	.title a:focus-visible {
		outline: none;
	}

	.project:has(a:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 3px;
	}

	p,
	.stack {
		grid-column: 1 / -1;
	}

	p {
		margin: 0.25rem 0 0;
	}

	/*
	 * The tools, with a dot between them. Each dot hangs to the left of its item,
	 * and the list clips its left edge, so a line never starts with a dot.
	 */
	.stack {
		display: flex;
		flex-wrap: wrap;
		column-gap: 1.6em;
		margin-top: 0.5rem;
		overflow: hidden;
	}

	.stack li {
		position: relative;
	}

	.stack li::before {
		content: '·';
		position: absolute;
		left: -1.1em;
	}
</style>
