---
interface Props {
	name: keyof typeof paths;
}

// Drawn as lines on a 16 x 16 grid, so every arrow matches the text beside it.
const paths = {
	'arrow-right': 'M2.75 8h10.5M9 3.75 13.25 8 9 12.25',
	'arrow-left': 'M13.25 8H2.75M7 3.75 2.75 8 7 12.25',
	'arrow-up-right': 'm4.5 11.5 7-7M5.75 4.5h5.75v5.75',
};

const { name } = Astro.props;
---

<svg
	class:list={['icon', `icon-${name}`]}
	viewBox="0 0 16 16"
	width="16"
	height="16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d={paths[name]}></path>
</svg>

<style>
	.icon {
		flex: none;
		width: 1em;
		height: 1em;
		vertical-align: -0.125em;
	}
</style>
