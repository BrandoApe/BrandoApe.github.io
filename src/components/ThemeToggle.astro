---
// The click handler is the inline script in src/layouts/Base.astro.
---

<button
	class="theme-toggle"
	type="button"
	data-theme-toggle
	aria-label="Switch between light and dark theme"
	title="Switch theme"
>
	<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
		<circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
		<path d="M8 2.25a5.75 5.75 0 0 1 0 11.5z" fill="currentColor"></path>
	</svg>
</button>

<style>
	.theme-toggle {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--muted);
		cursor: pointer;
		transition: color 0.15s;
	}

	.theme-toggle:hover {
		color: var(--fg);
	}

	@media print {
		.theme-toggle {
			display: none;
		}
	}
</style>
